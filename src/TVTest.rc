IDM_MENU MENU
BEGIN
	POPUP ""
	BEGIN
		POPUP "Zoom (&Z)"
		BEGIN
#ifndef TVTEST_FOR_1SEG
			MENUITEM "20%", CM_ZOOM_20
			MENUITEM "25%", CM_ZOOM_25
#endif
			MENUITEM "33% (1/3)", CM_ZOOM_33
			MENUITEM "50%", CM_ZOOM_50
			MENUITEM "67% (2/3)", CM_ZOOM_66
			MENUITEM "75%", CM_ZOOM_75
			MENUITEM "100%", CM_ZOOM_100
			MENUITEM "150%", CM_ZOOM_150
			MENUITEM "200%", CM_ZOOM_200
#ifdef TVTEST_FOR_1SEG
			MENUITEM "250%", CM_ZOOM_250
			MENUITEM "300%", CM_ZOOM_300
#endif
			MENUITEM SEPARATOR
			MENUITEM "Opciones de zoom (&O)...", CM_ZOOMOPTIONS
		END
		POPUP "Relación de aspecto (&A)"
		BEGIN
			MENUITEM "Automático", CM_ASPECTRATIO_DEFAULT
			MENUITEM "16:9", CM_ASPECTRATIO_16x9
			MENUITEM "16:9 Letterbox", CM_ASPECTRATIO_LETTERBOX
			MENUITEM "16:9 Windowbox", CM_ASPECTRATIO_WINDOWBOX
			MENUITEM "4:3 Pillarbox", CM_ASPECTRATIO_PILLARBOX
			MENUITEM "4:3", CM_ASPECTRATIO_4x3
#ifndef TVTEST_FOR_1SEG
			MENUITEM SEPARATOR
			MENUITEM "32:9", CM_ASPECTRATIO_32x9
			MENUITEM "16:9 Izquierda", CM_ASPECTRATIO_16x9_LEFT
			MENUITEM "16:9 Derecha", CM_ASPECTRATIO_16x9_RIGHT
#endif
			MENUITEM SEPARATOR
			MENUITEM "Recortar y ajustar a pantalla (&F)", CM_FRAMECUT
			MENUITEM "Ajustes de Pan && Scan (&P)...", CM_PANANDSCANOPTIONS
		END
		MENUITEM "Pantalla completa (&F)", CM_FULLSCREEN
		MENUITEM "Siempre visible (&W)", CM_ALWAYSONTOP
		MENUITEM SEPARATOR
		POPUP "Canal (&C)"
		BEGIN
			MENUITEM "", 0, GRAYED
		END
		POPUP "Servicio (&S)"
		BEGIN
			MENUITEM "", 0, GRAYED
		END
		POPUP "Sintonizador (&T)"
		BEGIN
			MENUITEM "", 0, GRAYED
		END
		POPUP "Canales favoritos (&L)"
		BEGIN
			MENUITEM SEPARATOR
			MENUITEM "Añadir a favoritos (&A)", CM_ADDTOFAVORITES
			MENUITEM "Organizar favoritos (&O)...", CM_ORGANIZEFAVORITES
		END
		POPUP "Canales recientes (&H)"
		BEGIN
			MENUITEM SEPARATOR
			MENUITEM "Limpiar historial", CM_CHANNELHISTORY_CLEAR
		END
		MENUITEM "Modo 1-Seg (&1)", CM_1SEGMODE
		MENUITEM SEPARATOR
		POPUP "Volumen (&V)"
		BEGIN
			MENUITEM "Silenciar (&M)", CM_VOLUME_MUTE
			MENUITEM "Subir (&U)", CM_VOLUME_UP
			MENUITEM "Bajar (&D)", CM_VOLUME_DOWN
			MENUITEM SEPARATOR
			MENUITEM "Sin ganancia (&N)", CM_AUDIOGAIN_NONE
			MENUITEM "Ganancia (x1.25)", CM_AUDIOGAIN_125
			MENUITEM "Ganancia (x1.5)", CM_AUDIOGAIN_150
			MENUITEM "Ganancia (x2.0)", CM_AUDIOGAIN_200
			MENUITEM SEPARATOR
			MENUITEM "5.1ch sin ganancia (&S)", CM_SURROUNDAUDIOGAIN_NONE
			MENUITEM "5.1ch ganancia (x1.25)", CM_SURROUNDAUDIOGAIN_125
			MENUITEM "5.1ch ganancia (x1.5)", CM_SURROUNDAUDIOGAIN_150
			MENUITEM "5.1ch ganancia (x2.0)", CM_SURROUNDAUDIOGAIN_200
		END
		POPUP "Audio (&M)"
		BEGIN
			MENUITEM "", 0, GRAYED
		END
		POPUP "Pista de video (&Q)"
		BEGIN
			MENUITEM "", 0, GRAYED
		END
		MENUITEM SEPARATOR
		MENUITEM "Iniciar/Detener grabación (&R)", CM_RECORD
		MENUITEM "Opciones de grabación (&D)...", CM_RECORDOPTION
		MENUITEM SEPARATOR
		MENUITEM "Copiar imagen (&P)\tC", CM_COPYIMAGE
		MENUITEM "Guardar imagen (&J)\tV", CM_SAVEIMAGE
		MENUITEM "Ventana de captura (&X)", CM_CAPTUREPREVIEW
		MENUITEM SEPARATOR
		MENUITEM "Desactivar reproducción (&I)", CM_DISABLEVIEWER
		POPUP "Reiniciar (&E)"
		BEGIN
			MENUITEM "Reiniciar todo (&R)", CM_RESET
			MENUITEM "Reiniciar visor (&V)", CM_RESETVIEWER
			MENUITEM "Reiniciar búfer (&B)", CM_RESETBUFFER
			MENUITEM SEPARATOR
			MENUITEM "Reconstruir grafo de filtros (&F)", CM_REBUILDVIEWER
		END
		MENUITEM SEPARATOR
		MENUITEM "Panel lateral (&N)", CM_PANEL
		MENUITEM "Guía de programas EPG (&G)", CM_PROGRAMGUIDE
		POPUP "Barras y bordes (&B)"
		BEGIN
			MENUITEM "Barra de título (&T)", CM_TITLEBAR
			MENUITEM "Barra de estado (&S)", CM_STATUSBAR
			MENUITEM "Barra lateral (&I)", CM_SIDEBAR
			MENUITEM SEPARATOR
			MENUITEM "Marco de ventana: Normal (&F)", CM_WINDOWFRAME_NORMAL
			MENUITEM "Marco de ventana: Delgado (&H)", CM_WINDOWFRAME_CUSTOM
			MENUITEM "Marco de ventana: Sin borde (&N)", CM_WINDOWFRAME_NONE
			MENUITEM SEPARATOR
			MENUITEM "Usar barra de título propia (&C)", CM_CUSTOMTITLEBAR
			MENUITEM "Dividir título con panel acoplado (&P)", CM_SPLITTITLEBAR
		END
		POPUP "Plugins (&U)"
		BEGIN
			MENUITEM "Ninguno", 0, GRAYED
		END
		MENUITEM "Configuración (&O)...", CM_OPTIONS
		POPUP "Propiedades de filtros (&Y)"
		BEGIN
			MENUITEM "Decodificador de video (&D)...", CM_VIDEODECODERPROPERTY
			MENUITEM "Renderizador de video (&R)...", CM_VIDEORENDERERPROPERTY
			MENUITEM "Filtro de audio (&A)...", CM_AUDIOFILTERPROPERTY
			MENUITEM "Renderizador de audio (&U)...", CM_AUDIORENDERERPROPERTY
			MENUITEM "MPEG-2 Demultiplexer (&M)...", CM_DEMULTIPLEXERPROPERTY
		END
		MENUITEM "Información del stream (&K)", CM_STREAMINFO
		MENUITEM SEPARATOR
		MENUITEM "Cerrar (&X)", CM_CLOSE
	END
END

