IDD_ABOUT DIALOG 0, 0, 224, 80
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Acerca de TVTest"
FONT DIALOG_FONT_SIZE, DIALOG_FONT_NAME
BEGIN
	CONTROL "", IDC_ABOUT_LOGO, WC_STATIC, SS_BITMAP | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE, 0, 0, 68, 80
	CTEXT "", IDC_ABOUT_HEADER, 72, 0, 144, 24, SS_OWNERDRAW
	// クレジットを追加する場合、\r\n で区切って書き足してください。
	// (サイズは変えなくてもダイアログ表示時に調整されます)
	CTEXT L"\x00A9 DBCTRADO / Traducción al español", IDC_ABOUT_INFO, 72, 32, 144, 32, SS_OWNERDRAW
	CTEXT "https://github.com/DBCTRADO/TVTest", IDC_ABOUT_LINK, 72, 64, 144, 8, SS_OWNERDRAW | SS_NOTIFY
END

IDD_INITIALSETTINGS DIALOG 0, 0, 316, 168
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Configuración inicial de TVTest"
FONT DIALOG_FONT_SIZE, DIALOG_FONT_NAME
BEGIN
	CONTROL "", IDC_INITIALSETTINGS_LOGO, WC_STATIC, SS_BITMAP | SS_CENTERIMAGE | WS_CHILD | WS_VISIBLE, 0, 0, 68, 168
	LTEXT "Configure los siguientes elementos.\nPuede cambiarlos más adelante.", -1, 76, 8, 224, 16
	RTEXT "BonDriver (&B):", -1, 76, 34, 80, 8
	COMBOBOX IDC_INITIALSETTINGS_DRIVER, 160, 32, 132, 80, CBS_DROPDOWN | CBS_SORT | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
	PUSHBUTTON "...", IDC_INITIALSETTINGS_DRIVER_BROWSE, 296, 32, 12, 12
	RTEXT "Decodif. MPEG-2 (&M):", -1, 76, 50, 80, 8
	COMBOBOX IDC_INITIALSETTINGS_MPEG2DECODER, 160, 48, 148, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	RTEXT "Decodif. H.264/AVC (&H):", -1, 76, 66, 80, 8
	COMBOBOX IDC_INITIALSETTINGS_H264DECODER, 160, 64, 148, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	RTEXT "Decodif. H.265/HEVC (&E):", -1, 76, 82, 80, 8
	COMBOBOX IDC_INITIALSETTINGS_H265DECODER, 160, 80, 148, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	RTEXT "Renderizador video (&R):", -1, 76, 98, 80, 8
	COMBOBOX IDC_INITIALSETTINGS_VIDEORENDERER, 160, 96, 80, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	LTEXT "Carpeta de grabaciones (&F):", -1, 76, 114, 140, 8
	EDITTEXT IDC_INITIALSETTINGS_RECORDFOLDER, 80, 126, 212, 12, ES_AUTOHSCROLL
	PUSHBUTTON "...", IDC_INITIALSETTINGS_RECORDFOLDER_BROWSE, 296, 126, 12, 12
	DEFPUSHBUTTON "Aceptar", IDOK, 208, 146, 48, 14
	PUSHBUTTON "Cancelar", IDCANCEL, 260, 146, 48, 14
	PUSHBUTTON "Ayuda (&H)", IDC_INITIALSETTINGS_HELP, 76, 146, 48, 14
END

IDD_OPTIONS DIALOG 0, 0, 348, 330
STYLE WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "Configuración"
FONT DIALOG_FONT_SIZE, DIALOG_FONT_NAME
