IDM_PROGRAMGUIDE MENU
BEGIN
	POPUP ""
	BEGIN
		POPUP "Fecha (&D)"
		BEGIN
			MENUITEM "Hoy", CM_PROGRAMGUIDE_DAY_TODAY
			MENUITEM "Mañana", CM_PROGRAMGUIDE_DAY_TODAY + 1
			MENUITEM "Pasado mañana", CM_PROGRAMGUIDE_DAY_TODAY + 2
			MENUITEM "En 3 días", CM_PROGRAMGUIDE_DAY_TODAY + 3
			MENUITEM "En 4 días", CM_PROGRAMGUIDE_DAY_TODAY + 4
			MENUITEM "En 5 días", CM_PROGRAMGUIDE_DAY_TODAY + 5
			MENUITEM "En 6 días", CM_PROGRAMGUIDE_DAY_TODAY + 6
			MENUITEM "En 7 días", CM_PROGRAMGUIDE_DAY_TODAY + 7
		END
