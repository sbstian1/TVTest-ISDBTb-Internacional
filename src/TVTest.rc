		BEGIN
			MENUITEM SEPARATOR
		END
		MENUITEM SEPARATOR
		POPUP "Filtrar (&F)"
		BEGIN
			MENUITEM "Programas gratuitos (&F)", CM_PROGRAMGUIDE_FILTER_FREE
			MENUITEM "Programas nuevos (&N)", CM_PROGRAMGUIDE_FILTER_NEWPROGRAM
			// [再] が設定されている番組が少ないのであまり意味が無い
			//MENUITEM "本放送(&O)", CM_PROGRAMGUIDE_FILTER_ORIGINAL
			//MENUITEM "再放送(&R)", CM_PROGRAMGUIDE_FILTER_RERUN
			MENUITEM SEPARATOR
			MENUITEM "Excluir televentas (&H)", CM_PROGRAMGUIDE_FILTER_NOT_SHOPPING
			MENUITEM SEPARATOR
			MENUITEM "Noticias (&E)", CM_PROGRAMGUIDE_FILTER_NEWS
			MENUITEM "Deportes (&S)", CM_PROGRAMGUIDE_FILTER_SPORTS
			MENUITEM "Información (&I)", CM_PROGRAMGUIDE_FILTER_INFORMATION
			MENUITEM "Drama / Series (&D)", CM_PROGRAMGUIDE_FILTER_DRAMA
			MENUITEM "Música (&M)", CM_PROGRAMGUIDE_FILTER_MUSIC
			MENUITEM "Variedades (&Y)", CM_PROGRAMGUIDE_FILTER_VARIETY
			MENUITEM "Películas (&V)", CM_PROGRAMGUIDE_FILTER_MOVIE
			MENUITEM "Anime / Animación (&A)", CM_PROGRAMGUIDE_FILTER_ANIME
			MENUITEM "Documentales / Cultura (&C)", CM_PROGRAMGUIDE_FILTER_DOCUMENTARY
			MENUITEM "Teatro / Espectáculos (&T)", CM_PROGRAMGUIDE_FILTER_THEATER
			MENUITEM "Aficiones / Educación (&U)", CM_PROGRAMGUIDE_FILTER_EDUCATION
			MENUITEM "Bienestar (&W)", CM_PROGRAMGUIDE_FILTER_WELFARE
		END
		MENUITEM "Buscar programas (&S)", CM_PROGRAMGUIDE_SEARCH
		MENUITEM "Configurar canales visibles (&H)...", CM_PROGRAMGUIDE_CHANNELSETTINGS
		MENUITEM SEPARATOR
		MENUITEM "Iniciar obtención de EPG (&U)", CM_PROGRAMGUIDE_UPDATE
		MENUITEM "Detener obtención de EPG (&E)", CM_PROGRAMGUIDE_ENDUPDATE
		MENUITEM "Actualizar información (&R)", CM_PROGRAMGUIDE_REFRESH
		MENUITEM "Actualización automática (&A)", CM_PROGRAMGUIDE_AUTOREFRESH
		MENUITEM SEPARATOR
		MENUITEM "Siempre visible (&A)", CM_PROGRAMGUIDE_ALWAYSONTOP
		MENUITEM "Arrastrar para desplazar (&C)", CM_PROGRAMGUIDE_DRAGSCROLL
		MENUITEM "Info emergente del programa (&P)", CM_PROGRAMGUIDE_POPUPEVENTINFO
		MENUITEM "Marcar programas destacados (&D)", CM_PROGRAMGUIDE_SHOWFEATUREDMARK
		MENUITEM "Mantener hora al cambiar fecha (&K)", CM_PROGRAMGUIDE_KEEPTIMEPOS
		POPUP "Barra de herramientas (&B)"
		BEGIN
			MENUITEM "Menú de sintonizador (&T)", CM_PROGRAMGUIDE_TOOLBAR_TUNERMENU
			MENUITEM "Menú de fecha (&D)", CM_PROGRAMGUIDE_TOOLBAR_DATEMENU
