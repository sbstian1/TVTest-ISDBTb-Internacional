BEGIN
	POPUP ""
	BEGIN
		MENUITEM "Fijar barra lateral (&S)", CM_SIDEBAR
		POPUP "Posición (&P)"
		BEGIN
			MENUITEM "Izquierda (&L)", CM_SIDEBAR_PLACE_LEFT
			MENUITEM "Derecha (&R)", CM_SIDEBAR_PLACE_RIGHT
			MENUITEM "Arriba (&T)", CM_SIDEBAR_PLACE_TOP
			MENUITEM "Abajo (&B)", CM_SIDEBAR_PLACE_BOTTOM
		END
		MENUITEM SEPARATOR
		MENUITEM "Ajustes de barra lateral (&O)...", CM_SIDEBAROPTIONS
	END
END

IDM_COLORSCHEME MENU
BEGIN
	POPUP ""
	BEGIN
		MENUITEM "Seleccionar elementos del mismo color (&S)", IDC_COLORSCHEME_SELECTSAMECOLOR
		MENUITEM SEPARATOR
		POPUP "Tipo de degradado (&G)", GRAYED
		BEGIN
			MENUITEM "Normal (&N)", IDC_COLORSCHEME_GRADIENT_NORMAL
			MENUITEM "Brillante (&G)", IDC_COLORSCHEME_GRADIENT_GLOSSY
			MENUITEM "Entrelazado (&I)", IDC_COLORSCHEME_GRADIENT_INTERLACED
		END
		POPUP "Dirección de degradado (&D)", GRAYED
		BEGIN
			MENUITEM "Horizontal (&H)", IDC_COLORSCHEME_DIRECTION_HORZ
			MENUITEM "Vertical (&V)", IDC_COLORSCHEME_DIRECTION_VERT
			MENUITEM "Simétrico horizontal (&M)", IDC_COLORSCHEME_DIRECTION_HORZMIRROR
			MENUITEM "Simétrico vertical (&R)", IDC_COLORSCHEME_DIRECTION_VERTMIRROR
		END
		POPUP "Tipo de borde (&B)", GRAYED
		BEGIN
			MENUITEM "Ninguno (&N)", IDC_COLORSCHEME_BORDER_NONE
			MENUITEM "Sólido (&F)", IDC_COLORSCHEME_BORDER_SOLID
			MENUITEM "Hundido (&S)", IDC_COLORSCHEME_BORDER_SUNKEN
			MENUITEM "Elevado (&R)", IDC_COLORSCHEME_BORDER_RAISED
		END
	END
END

