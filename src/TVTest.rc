	LISTBOX IDC_OPTIONS_LIST, 4, 4, 88, 300, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP | WS_CLIPSIBLINGS
	LTEXT "", IDC_OPTIONS_TITLE, 100, 4, 240, 12, SS_OWNERDRAW | WS_CLIPSIBLINGS
	LTEXT "", IDC_OPTIONS_PAGEPLACE, 92, 16, 256, 288, NOT WS_VISIBLE
	LTEXT "", IDC_OPTIONS_SEPARATOR, 4, 308, 340, 1, SS_ETCHEDHORZ | WS_CLIPSIBLINGS
	DEFPUSHBUTTON "Aceptar", IDOK, 244, 312, 48, 14, WS_CLIPSIBLINGS
	PUSHBUTTON "Cancelar", IDCANCEL, 296, 312, 48, 14, WS_CLIPSIBLINGS
	PUSHBUTTON "Ayuda", IDC_OPTIONS_HELP, 4, 312, 48, 14, WS_CLIPSIBLINGS
END

IDD_OPTIONS_GENERAL DIALOG 0, 0, 256, 288
STYLE DS_CONTROL | WS_CHILD
CAPTION "General"
FONT DIALOG_FONT_SIZE, DIALOG_FONT_NAME
BEGIN
	AUTOCHECKBOX "Modo residente en bandeja (&I)", IDC_OPTIONS_RESIDENT, 8, 8, 236, 9
	AUTOCHECKBOX "Impedir múltiples instancias (&K)", IDC_OPTIONS_KEEPSINGLETASK, 8, 20, 236, 9
	AUTOCHECKBOX "Mantener guía EPG al cerrar ventana principal (&G)", IDC_OPTIONS_STANDALONEPROGRAMGUIDE, 8, 32, 236, 9
	AUTOCHECKBOX "Agrupar barra de tareas por ruta (&T) (req. reinicio)", IDC_OPTIONS_USEUNIQUEAPPID, 8, 44, 240, 9
	AUTOCHECKBOX "Cambiar a 1-Seg si no hay señal Full-Seg (&1)", IDC_OPTIONS_ENABLE1SEGFALLBACK, 8, 56, 236, 9

	LTEXT "Carpeta BonDriver (&F): (req. reinicio)", -1, 8, 72, 132, 8
	RTEXT "*Vacío = carpeta del programa", -1, 140, 72, 108, 8
	EDITTEXT IDC_OPTIONS_DRIVERDIRECTORY, 16, 84, 216, 12, ES_AUTOHSCROLL
	PUSHBUTTON "...", IDC_OPTIONS_DRIVERDIRECTORY_BROWSE, 236, 84, 12, 12

	AUTORADIOBUTTON "Ninguno (&N)", IDC_OPTIONS_DEFAULTDRIVER_NONE, 16, 112, 100, 9, WS_GROUP
	AUTORADIOBUTTON "Último BonDriver usado (&L)", IDC_OPTIONS_DEFAULTDRIVER_LAST, 16, 124, 160, 9
	AUTORADIOBUTTON "BonDriver específico (&D)", IDC_OPTIONS_DEFAULTDRIVER_CUSTOM, 16, 136, 160, 9
	COMBOBOX IDC_OPTIONS_DEFAULTDRIVER, 24, 148, 200, 80, CBS_DROPDOWN | CBS_SORT | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP | WS_GROUP
	PUSHBUTTON "...", IDC_OPTIONS_DEFAULTDRIVER_BROWSE, 228, 148, 12, 12
	GROUPBOX "BonDriver predeterminado", -1, 8, 100, 240, 68, WS_CLIPSIBLINGS

	AUTOCHECKBOX "Habilitar Jump List (&J)", IDC_OPTIONS_ENABLEJUMPLIST, 12, 176, 140, 9
	AUTOCHECKBOX "Instancia única desde Jump List (&S)", IDC_OPTIONS_JUMPLISTKEEPSINGLETASK, 16, 188, 200, 9
	GROUPBOX "", -1, 8, 176, 240, 28, WS_CLIPSIBLINGS

	AUTOCHECKBOX "Desactivar protector de pantalla (&S)", IDC_OPTIONS_NOSCREENSAVER, 16, 224, 200, 9
	AUTOCHECKBOX "Desactivar ahorro de energía del monitor (&L)", IDC_OPTIONS_NOMONITORLOWPOWER, 16, 236, 200, 9
	AUTOCHECKBOX "Solo cuando esté activo (&C)", IDC_OPTIONS_NOMONITORLOWPOWERACTIVEONLY, 24, 248, 160, 9
	GROUPBOX "Prevención de suspensión", -1, 8, 212, 240, 52, WS_CLIPSIBLINGS
END

IDD_OPTIONS_VIEW DIALOG 0, 0, 256, 288
STYLE DS_CONTROL | WS_CHILD
CAPTION "Visualización"
FONT DIALOG_FONT_SIZE, DIALOG_FONT_NAME
BEGIN
	AUTOCHECKBOX "Acoplar a bordes de ventana y pantalla (&P)", IDC_OPTIONS_SNAPATWINDOWEDGE, 8, 8, 236, 9
	AUTOCHECKBOX "Soportar acoplamiento de ventana (Aero Snap) (&E)", IDC_OPTIONS_SUPPORTAEROSNAP, 8, 20, 236, 9
	AUTOCHECKBOX "Ajustar al aspecto del video al redimensionar (&A)", IDC_OPTIONS_ADJUSTASPECTRESIZING, 8, 32, 236, 9
	AUTOCHECKBOX "Anclar esquina más cercana al cambiar tamaño (&Z)", IDC_OPTIONS_NEARCORNERRESIZEORIGIN, 8, 44, 236, 9
	AUTOCHECKBOX "Mantener aspecto de ventana al cambiar zoom (&K)", IDC_OPTIONS_ZOOMKEEPASPECTRATIO, 8, 56, 236, 9
